# Admin dashboard login (required for /admin)
# Vercel: set ADMIN_PASSWORD in Project → Settings → Environment Variables, then redeploy.
ADMIN_PASSWORD=change-this-strong-password
# Local dev fallback (optional; dev also accepts 1234 if no password is set)
VITE_ADMIN_PASSWORD=change-this-strong-password

# Supabase (optional — without these, ride log + settings use localStorage)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
